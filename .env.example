# ---- required ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgres://wgetpanel:wgetpanel@postgres:5432/wgetpanel
# Celery broker
REDIS_URL=redis://redis:6379/0            
# live speed / control channel
WGP_REDIS_URL=redis://redis:6379/1        

# first admin (created by `manage.py bootstrap`)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=admin@example.com

# ---- hosts / TLS (set these behind a TLS-terminating proxy) -----------------
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_BEHIND_PROXY=0
DJANGO_SECURE_COOKIES=0
DJANGO_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0

# ---- wgetpanel --------------------------------------------------------------
WGP_DOWNLOAD_ROOT=/downloads
WGP_LOG_DIR=/var/log/wgetpanel
# SSRF guard, keep on for multi-user installs
WGP_BLOCK_PRIVATE_ADDRESSES=1             
# seconds between scheduler ticks
WGP_SCHEDULER_TICK=2.0                    
# must be >= "Max simultaneous downloads" in Settings  
WGP_WORKER_CONCURRENCY=8                  
# Fernet key; default is derived from DJANGO_SECRET_KEY
# FIELD_ENCRYPTION_KEY=                   
# mobile API token lifetime, 0 = never expires  
WGP_TOKEN_TTL_DAYS=180                    
# max length of one /api/v1/events connection (clients reconnect)
WGP_SSE_MAX_SECONDS=3600                   
# concurrent SSE streams = workers x threads
GUNICORN_WORKERS=3                        
GUNICORN_THREADS=32
# Fernet key; default is derived from DJANGO_SECRET_KEY
# FIELD_ENCRYPTION_KEY=                     
# DJANGO_LOG_LEVEL=INFO
TZ=Asia/Jakarta
DJANGO_DEBUG=False
