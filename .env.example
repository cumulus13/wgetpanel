# ---- required ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgres://wgetpanel:wgetpanel@postgres:5432/wgetpanel
REDIS_URL=redis://redis:6379/0            # Celery broker
WGP_REDIS_URL=redis://redis:6379/1        # live speed / control channel

# first admin (created by `manage.py bootstrap`)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=admin@example.com

# ---- hosts / TLS (set these behind a TLS-terminating proxy) -----------------
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_BEHIND_PROXY=0
DJANGO_SECURE_COOKIES=0
DJANGO_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0

# ---- wgetpanel --------------------------------------------------------------
WGP_DOWNLOAD_ROOT=/data/downloads
WGP_LOG_DIR=/data/logs
WGP_BLOCK_PRIVATE_ADDRESSES=1             # SSRF guard, keep on for multi-user installs
WGP_SCHEDULER_TICK=2                      # seconds between scheduler ticks
WGP_WORKER_CONCURRENCY=8                  # must be >= "Max simultaneous downloads" in Settings
# FIELD_ENCRYPTION_KEY=                     # Fernet key; default is derived from DJANGO_SECRET_KEY
# DJANGO_LOG_LEVEL=INFO
