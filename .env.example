# ---- required ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgres://wgp:wgp@localhost:5432/wgp
# Celery broker
REDIS_URL=redis://localhost:6379/0            
# live speed / control channel
WGP_REDIS_URL=redis://localhost:6379/1        

# first admin (created by `manage.py bootstrap`)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=admin@example.com

# ---- hosts / TLS (set these behind a TLS-terminating proxy) -----------------
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
DJANGO_BEHIND_PROXY=0
DJANGO_SECURE_COOKIES=0
DJANGO_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0

# ---- wgetpanel --------------------------------------------------------------
WGP_DOWNLOAD_ROOT=/downloads
WGP_LOG_DIR=/var/log/wgetpanel
# SSRF guard, keep on for multi-user installs
WGP_BLOCK_PRIVATE_ADDRESSES=1             
# seconds between scheduler ticks
WGP_SCHEDULER_TICK=2.0                    
# must be >= "Max simultaneous downloads" in Settings  
WGP_WORKER_CONCURRENCY=8                  
# Fernet key; default is derived from DJANGO_SECRET_KEY
# FIELD_ENCRYPTION_KEY=                   
# mobile API token lifetime, 0 = never expires  
WGP_TOKEN_TTL_DAYS=180                    
# max length of one /api/v1/events connection (clients reconnect)
WGP_SSE_MAX_SECONDS=3600                   
# concurrent SSE streams = workers x threads
GUNICORN_WORKERS=3                        
GUNICORN_THREADS=32
# Fernet key; default is derived from DJANGO_SECRET_KEY
# FIELD_ENCRYPTION_KEY=                     
# DJANGO_LOG_LEVEL=INFO
TZ=Asia/Jakarta
DJANGO_DEBUG=False
# ---- notifications (optional; nothing is sent unless NTFY_* and/or GNTP_* is set) ------------------------------
NOTIFY_EVENTS=completed,error,paused,retry   # also: canceled. Aliases: success=completed, failed=error, pause=paused
NOTIFY_RETRY_INTERVAL=60                     # retry notices: at most one per download per N seconds (0 = every retry, -1 = never)
NOTIFY_PANEL_URL=                            # e.g. https://panel.example.com  (link in the notification)
NOTIFY_TIMEOUT=10
# ntfy: server root WITHOUT the topic. Use a token, or user + password, or neither for an open topic
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
NTFY_USER=
NTFY_PASSWORD=
# Per-user channels (each user configures them on the Notifications page / `wgp notify` / /api/v1/notify)
NOTIFY_GLOBAL_SCOPE=all                      # all = the channel above also gets every user's events; none = it gets nobody's (privacy)
NTFY_USER_TOPIC_PREFIX=wgetpanel             # every user gets a private topic "<prefix>-<random>" on NTFY_URL (published with the credentials above)
NOTIFY_USER_GNTP_ALLOW=                      # CIDRs users may point their own GNTP receiver at, e.g. 192.168.1.0/24 ; empty = per-user GNTP is OFF
# GNTP / Growl receiver (global channel)
GNTP_HOST=
GNTP_PORT=23053
GNTP_PASSWORD=
GNTP_APP_NAME=wgetpanel

